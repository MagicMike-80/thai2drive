# Kopier til frontend/.env og fyll inn. frontend/.env spores ikke i git.
EXPO_TUNNEL_SUBDOMAIN=thai2drive
EXPO_PACKAGER_HOSTNAME=localhost
EXPO_PUBLIC_BACKEND_URL=https://www.thai2drive.no
EXPO_USE_FAST_RESOLVER="1"
METRO_CACHE_ROOT=/app/frontend/.metro-cache

# RevenueCat PUBLIC SDK-nøkkel (EXPO_PUBLIC_* havner i appbygget, så aldri legg en hemmelig nøkkel her).
#   Android: starter med "goog_..."  (RevenueCat > Project settings > API keys > Google)
#   iOS:     starter med "appl_..."  (RevenueCat > Project settings > API keys > Apple)
# En verdi som ikke starter med goog_/appl_ behandles av appen som «ingen betalingsmur».
# For EAS-bygg: sett den som EAS secret i stedet for å ha den i en fil.
EXPO_PUBLIC_RC_API_KEY=replace_with_public_sdk_key
